rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'be@ike.works',
          'chriscronmusic@gmail.com'
        ];
    }

    function isAdmin() {
      return signedIn()
        && (
          isAdminEmail()
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /parts/{partSlug} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /assets/{assetId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /mixerTracks/{trackId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /mixerVideos/{videoId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /annotations/{annotationId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /mixerSettings/{settingsId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /memberPrivate/{memberId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /bands/{bandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /setups/{setupId} {
      allow read, create, update, delete: if isAdmin();

      match /graphs/{graphId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /equipmentTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /inventoryAssets/{assetId} {
      allow read, create, update, delete: if isAdmin();

      match /checkIns/{checkInId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /gearPublicAssets/{assetTag} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'assetTag',
          'label',
          'updatedAt'
        ])
        && request.resource.data.assetTag is string
        && request.resource.data.label is string;
      allow delete: if isAdmin();
    }

    match /gearParties/{partyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /gearLocations/{locationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /purchaseOrders/{orderId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /connectorTypes/{connectorTypeId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /cableInventory/{inventoryItemId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /memberSongDefaults/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bandSongOverrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
