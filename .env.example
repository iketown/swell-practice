NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Comma-separated admin emails. Read-only pages work without auth.
NEXT_PUBLIC_ADMIN_EMAILS=
# Exact Firebase Auth emails for the two Money founders. The server uses the
# verified account to identify the chat speaker; messages cannot override it.
NEXT_PUBLIC_MONEY_IKE_EMAIL=
NEXT_PUBLIC_MONEY_CHRIS_EMAIL=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
OPEN_ROUTER_API_KEY=

# Server-only Firestore access for traffic collection and the admin traffic API.
# Paste the service-account private key with literal \n separators when setting it in Vercel.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional. Equipment URL research defaults to openai/gpt-5.6-terra.
OPEN_ROUTER_EQUIPMENT_IMPORT_MODEL=openai/gpt-5.6-terra

# Money receipt interpretation (server-only, uses OPEN_ROUTER_API_KEY above).
# Default is DeepSeek V4.1 Flash; requests have a provider price ceiling.
OPEN_ROUTER_MONEY_MODEL=deepseek/deepseek-v4.1-flash
# Optional. Ronnie-bot uses the Agents SDK through OpenRouter.
OPEN_ROUTER_MONEY_AGENT_MODEL=openai/gpt-5.6-terra
# The deployed HTTPS origin, without a trailing path.
MONEY_SITE_URL=https://theswell.live
# Create a bot with Telegram's @BotFather. Never expose these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FINANCE_CHAT_ID=
TELEGRAM_IKE_USER_ID=
TELEGRAM_CHRIS_USER_ID=
